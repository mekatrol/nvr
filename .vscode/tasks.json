{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start NVR Vue UI",
            "type": "shell",
            "command": "npm run dev:debug",
            "options": {
                "cwd": "${workspaceFolder}/src/nvr_ui"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "vite",
                "pattern": {
                    "regexp": "^$",
                    "file": 1,
                    "location": 2,
                    "message": 3
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*VITE.*",
                    "endsPattern": ".*Local:\\s+http://127\\.0\\.0\\.1:5173/.*"
                }
            }
        }
    ]
}
